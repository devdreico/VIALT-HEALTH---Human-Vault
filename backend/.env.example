# VIALT API — entorno de desarrollo local
# Copia como .env (ya existe uno de dev). Variables disponibles:

# Modelo de IA (dev: 1.5b rápido; VPS: 3b)
VIALT_OLLAMA_MODEL=qwen2.5:1.5b
VIALT_OLLAMA_BASE_URL=http://127.0.0.1:11434
VIALT_SEARXNG_BASE_URL=http://127.0.0.1:8888

# Cifrado de vaults .md en reposo (déjalo vacío en dev)
# VIALT_VAULT_SECRET=llave-larga-aleatoria

# JWT
VIALT_SECRET_KEY=cambiar-en-produccion

# Google OAuth
VIALT_GOOGLE_CLIENT_ID=
VIALT_GOOGLE_CLIENT_SECRET=
VIALT_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
VIALT_FRONTEND_URL=http://localhost:5173

# CORS adicional de producción (coma separada)
# VIALT_EXTRA_CORS=https://vialt.vercel.app
