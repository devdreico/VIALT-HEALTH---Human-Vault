# Variables públicas de build de Vite y configuración del contenedor web.
# No guardes aquí secretos de servicio_role ni credenciales de proveedores.

# Dominio apuntando al VPS (Caddy termina TLS)
VIALT_DOMAIN=vialt.tu-dominio.com

# URL y publishable/anon key del proyecto Supabase. Se incorporan al bundle del navegador.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
