# ══════════════════════════════════════════════════════════════════
#  VIALT — variables de entorno para Docker Compose (VPS)
#  Copia este archivo como `.env` y ajústalo. NADA debe quedar "cambiar-en-produccion".
# ══════════════════════════════════════════════════════════════════

# Dominio apuntando al VPS (Caddy termina HTTPS con este nombre)
VIALT_DOMAIN=vialt.tu-dominio.com

# Clave de firma JWT — genera una:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
VIALT_SECRET_KEY=CAMBIAR-ME

# Cifrado en reposo de los .md (Fernet) — CLAVE OBLIGATORIA en VPS:
VIALT_VAULT_SECRET=CAMBIAR-ME-TAMBIEN

# Modelo de IA local (3b = calidad; 1.5b = CPU sin GPU; en VPS con GPU usa 3b+)
VIALT_OLLAMA_MODEL=qwen2.5:3b

# Dominios del frontend desplegado en Vercel (coma-separados)
VIALT_EXTRA_CORS=https://vialt.vercel.app

# Google OAuth (opcional hasta configurarlo en Cloud Console)
VIALT_GOOGLE_CLIENT_ID=
VIALT_GOOGLE_CLIENT_SECRET=
VIALT_GOOGLE_REDIRECT_URI=https://vialt.tu-dominio.com/api/auth/google/callback

# URL del frontend para los redirecciones del callback de Google
VIALT_FRONTEND_URL=https://vialt.vercel.app
